{
  "name": "gatepass",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "preview": "opennextjs-cloudflare build && wrangler dev",
    "deploy": "opennextjs-cloudflare build && wrangler deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv",
    "test": "tsx --test tests/*.test.ts",
    "prebuild": "npm run cf-typegen",
    "typecheck": "npm run cf-typegen && tsc --noEmit"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.15",
    "@zxing/browser": "^0.2.1",
    "aws4fetch": "^1.0.20",
    "next": "16.4.4",
    "qrcode": "^1.5.4",
    "qrcode-generator": "^2.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "wrangler": "^4.156.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "@types/qrcode-generator": "^0.0.16",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.4",
    "jsqr": "^1.4.0",
    "playwright": "^1.64.1",
    "pngjs": "^7.0.0",
    "tailwindcss": "^4",
    "tsx": "^4.20.0",
    "typescript": "^5"
  },
  "overrides": {
    "glob": "^14.0.3",
    "minimatch": "^11.0.4"
  }
}
